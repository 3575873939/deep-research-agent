# ---- LLM 通道（OpenAI 兼容端点）----
# ModelScope 示例：https://api-inference.modelscope.cn/v1
# DeepSeek 示例：https://api.deepseek.com
# AIHubMix 示例：https://aihubmix.com/v1
DRA_BASE_URL=https://api-inference.modelscope.cn/v1
DRA_API_KEY=your-api-key-here

# 节点级模型路由：可指向不同 provider 的模型（verifier 建议与生成侧异模）
DRA_MODEL_PLANNER=deepseek-ai/DeepSeek-V4.1-Flash
DRA_MODEL_RESEARCHER=deepseek-ai/DeepSeek-V4.1-Flash
DRA_MODEL_SYNTHESIZER=deepseek-ai/DeepSeek-V4.1-Flash
DRA_MODEL_VERIFIER=deepseek-ai/DeepSeek-V4.1-Flash
DRA_MODEL_LIGHT=deepseek-ai/DeepSeek-V4.1-Flash

# ---- 预算与熔断 ----
DRA_MAX_TOKENS_PER_RUN=200000
DRA_RATE_LIMIT_COOLDOWN_S=900
# 客户端最小调用间隔（秒）。0 = 不限速；免费档限速的通道（如 5 请求/分钟）设 ~12.5
DRA_MIN_CALL_INTERVAL_S=0

# ---- 搜索工具 ----
# SerpAPI 优先，Tavily 兜底，DuckDuckGo 最后
SERPAPI_KEY=
TAVILY_API_KEY=

# ---- 检索增强（RAG）----
RAG_ENABLED=true
RAG_TOP_K=16
RAG_USE_VECTOR=true
RAG_USE_RERANKER=false
RAG_LOCAL_FILES_ONLY=true
RAG_VECTOR_MIN_SCORE=0.45

# ---- 存储 ----
DRA_DB_PATH=./data/research.db
DRA_TRACE_PATH=./data/traces.jsonl
