# ---- 环境变量：含密钥，绝不入库 ----
.env
.env.*
!.env.example

# ---- 运行时数据：引用快照库 / trace（体积大且含抓取内容）----
data/
src/data/
*.db
*.sqlite3

# ---- 评测中间产物：保留有实验意义的记录，排除探索期噪音 ----
evals/reports/*.bak
evals/results_*smoke*.jsonl
evals/results_v2.jsonl
evals/results_v3_smoke.jsonl
evals/results_v4_smoke.jsonl

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
